<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link rel="stylesheet" href="Style/adminpanel.css">
</head>
<body>
  <div class="container">
    <div class="sidebar">
      <h2>Admin Panel</h2>
      <ul>
        <li><a href="#" id="users-link">Users</a></li>
        <li><a href="#" id="adminlogin-link">Pending orders</a></li>
        <li><a href="#" id="notes-link"> Promo code</a></li>
        <li><a href="#" id="forms-link">Products</a></li>
        <li><a href="#" id="login-link">Order History</a></li>
        <li><a href="#" id="adminusers-link">cancel request</a></li>

         
        <!-- <li><a href="#" id="changepassword-link">Change Password</a></li>
        <li><a href="#" id="registeradmin-link">Register Admin</a></li> -->
         
     </ul> 
    </div>
  
  
    <div class="three-dot-menu">
      <i class="fas fa-ellipsis-v"></i>
      <div class="menu-content">
        <ul>
          <li><a href="#" data-section="users-section">Users</a></li>
          <li><a href="#" data-section="login-section">order history</a></li>
          <li><a href="#" data-section="notes-section">promo code</a></li>
          <li><a href="#" data-section="forms-section">products</a></li>
          <li><a href="#" data-section="adminlogin-section">pending orders</a></li>
          <!-- <li><a href="#" data-section="changepassword-section">Change Password</a></li>
          <li><a href="#" data-section="registeradmin-section">Register Admin</a></li> -->
          <li><a href="#" data-section="adminusers-section">cancel request</a></li>
        </ul>
      </div>
    </div>
     

    <div class="main-content">
      <!-- Users Section -->
      <div id="users-section" class="content-section">
        <h3>Users</h3>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Email</th>
              <th>Password</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.forEach(user => { %>
                <tr>
                  <td><%= user.id %></td>
                  <td><%= user.email %></td>
                  <td><%= user.password %></td>
                  <td>
                    <form style="padding: 0; margin: 0;" method="post" action="/deleteuser/<%= user.id %>">
                    <button type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4">No users found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Login Attempts Section -->
      <div id="login-section" class="content-section">
        <h2>Order History</h2>
        <table border="1">
          <thead>
            <tr>
              <th>ID</th>
              <th>USER ID</th>
              <th>USER NAME</th>
              <th>BILLING ADDRESS</th>
              <th>ORDER DATE</th>
              <th>PAYMENT STATUS</th>
              <th>PAYMENT ID</th>
              <th>ORDER ID</th>
              <th>ITEMS</th>

            </tr>
          </thead>
          <tbody>
            <% if (orders && orders.length > 0) { %>
              <% orders.forEach(order => { %>
                <tr>
                  <td><%= order.id %></td>
                  <td><%= order.user_id %></td>
                  <td><%= order.user_name%></td>
                  <td><%= order.billing_address%></td>
                  <td><%= order.order_date%></td>
                  <td><%= order.payment_status%></td>
                  <td><%= order.razorpay_payment_id%></td>
                  <td><%= order.razorpay_order_id%></td>
                   <!-- Check if items data exists -->

                  <td>
                    <p><%= JSON.stringify(order.items) %></p> 
                     
                  </td>

                  
                  
                   
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4">No orders found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Add Notes Section -->
      <div id="notes-section" class="content-section">
         
        <h3>Prome codes</h3>
        <form action="/addpromocode" method="post" >
          <!-- Your existing form fields -->
           
          
          <label for="code">Promo Code:</label>
          <input type="text" name="code" id="code" required>
          <label for="price_offer">Price</label>
          <input type="number" name="price_offer" id="price_offer" required>
           
          <button type="submit">Submit</button>
      </form>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Email</th>
              <th>Timestamp</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (promo_codes && promo_codes.length > 0) { %>
              <% promo_codes.forEach(promo_code => { %>
                <tr>
                  <td><%= promo_code.id %></td>
                  <td><%= promo_code.code %></td>
                  <td><%= promo_code.price_offer %></td>
                  <td>
                    <form style="padding: 0; margin: 0;" method="post" action="/deletepromo_code/<%= promo_code.id %>">
                      <button type="submit">Delete</button>
                      </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4">No admin logins found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
       
         </div>

      <!-- Forms Section -->
      <div id="forms-section" class="content-section">
        <h3>products</h3>
        <form action="/addproduct" method="post" >
          <!-- Your existing form fields -->
          <label for="name">Name:</label>
          <input type="text" name="name" id="name" required>

          <label for="price">Price:</label>
          <input type="number" name="price" id="price" required>
          
          <label for="imageurl1">Imageurl 1:</label>
          <input type="text" name="imageurl" id="imageurl" required>

          <label for="img2">Imageurl 2:</label>
          <input type="text" name="img2" id="img2" required>

          <label for="img3">Imageurl 3:</label>
          <input type="text" name="img3" id="img3" required>

          <label for="img4">Imageurl 4:</label>
          <input type="text" name="img4" id="img4" required>

          <label for="category">Category :</label>
          <input type="text" name="category" id="category" required>

          <label for="description">description:</label>
          <input type="text" name="description" id="description" required>


          <label for="sizes">Sizes</label>
          <input type="text" name="sizes" id="price_offer" required>
           
          <button type="submit">Submit</button>

          </form>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>price</th>
              <th>category</th>
              <th>Description</th>
              <th>Image url 1</th>
              <th>Image url 2</th>
              <th>Image url 3</th>
              <th>Image url 4</th>
              <th>Sizes</th>
              <th>Action</th>

            </tr>
          </thead>
          <tbody>
            <% if (products && products.length > 0) { %>
              <% products.forEach(product => { %>
                <tr>
                  <td><%= product.id %></td>
                  <td><%= product.name %></td>
                  <td><%= product.price %></td>
                  <td><%= product.category%></td>
                  <td><%= product.description %></td>
                  <td><%= product.imageurl %></td>
                  <td><%= product.img2 %></td>
                  <td><%= product.img3 %></td>
                  <td><%= product.img4 %></td>
                  <td><%= product.sizes %></td>

                   
                  <td>
                    <form style="padding: 0; margin: 0;" method="post" action="/deleteproduct/<%= product.id %>">
                      <button type="submit">Delete</button>
                      </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6">No forms found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Admin Logins Section -->
      <div id="adminlogin-section" class="content-section">
             
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>USER ID</th>
              <th>USER NAME</th>
              <th>BILLING ADDRESS</th>
              <th>ITEMS</th>
              <th>ORDER DATE</th>
              <th>PAYMENT STATUS</th>
              <th>PAYMENT ID</th>
              <th>ORDER ID</th>
              <th>Action</th>
               

            </tr>
          </thead>
          <tbody>
            <% if (pendingorders && pendingorders.length > 0) { %>
              <% pendingorders.forEach(pendingorder => { %>
                <tr>
                  <td><%= pendingorder.id %></td>
                  <td><%= pendingorder.user_id %></td>
                  <td><%= pendingorder.user_name%></td>
                  <td><%= pendingorder.billing_address%></td>
                  <td>
                    <p><%= JSON.stringify(pendingorder.items) %></p> 
                     
                  </td>
                  <td><%= pendingorder.order_date%></td>
                  <td><%= pendingorder.payment_status%></td>
                  <td><%= pendingorder.razorpay_payment_id%></td>
                  <td><%= pendingorder.razorpay_order_id%></td>
                   
                  <td>
                    <form style="padding: 0; margin: 0;" method="post" action="/approveorder/<%= pendingorder.id %>">
                      <button type="submit">Mark Done</button>
                      </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6">No pending orders found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div id="changepassword-section" class="content-section">
        <div class="change-password-form-container">
          <form id="changePasswordForm" method="post" action="/changeadminpassword">
            <div class="change-password-form-group">
              <label for="oldPassword">Old Password:</label>
              <input type="password" name="oldPassword" id="oldPassword" required>
              <i id="toggleOldPassword" class="fa fa-eye"></i>
            </div>
            <div class="change-password-form-group">
              <label for="newPassword">New Password:</label>
              <input type="password" name="newPassword" id="newPassword" required>
              <i id="toggleNewPassword" class="fa fa-eye"></i>
            </div>
            <div class="change-password-button-container">
              <button type="submit">Change Password</button>
            </div>
          </form>
        </div>
      </div>
      



      <div id="registeradmin-section" class="content-section">
        <div class="admin-form-container">
          <form id="registerAdminForm" method="post" action="/registeradmin">
            <div class="admin-form-group">
              <input type="email" id="adminEmail" name="email"   placeholder="Admin Email" required />
            </div>
            <div class="admin-form-group">
              <input type="password" id="adminPassword" name="password" placeholder="Admin Password" required />
              <i class="fa fa-eye" id="toggleAdminPassword"></i>
            </div>
            <div class="admin-button-container">
              <button type="submit">Register Admin</button>
            </div>
            <p id="adminMessage" class="admin-message"></p>
          </form>
        </div> 
      </div>
      <div id="adminusers-section" class="content-section">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Email</th>
              <th>Action</th>
              
               

            </tr>
          </thead>
          <tbody>
            <% if (cancel_order && cancel_order.length > 0) { %>
              <% cancel_order.forEach(cancel_order => { %>
                <tr>
                  <td><%= cancel_order.id %></td>
                  <td><%= cancel_order.email %></td>
                   
                  <td>
                    <form style="padding: 0; margin: 0;" method="post" action="/cancelorder/<%= cancel_order.id %>">
                      <button type="submit">Mark Done</button>
                      </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6">No pending orders found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      
      </div>
    </div>
  </div>
  <script src="/JavaScript/adminpanelscript.js"></script>
</body>
</html>
