<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Profile</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      /* Global styles */
      body {
        font-family: "Poppins", sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
        color: #333;
      }

      header {
        display: flex;
        justify-content: space-between;
        padding: 10px 20px;
        background-color: #ffffff;
        align-items: center;
        border-bottom: 2px solid #ddd;
      }

      header img {
        height: 40px;
      }

      .menu-btn {
        font-size: 30px;
        cursor: pointer;
        background: none;
        border: none;
        color: black;
      }

      .sidebar {
        position: fixed;
        top: 0;
        left: -250px;
        width: 250px;
        height: 100%;
        background-color: #ffffff;
        color: rgb(0, 0, 0);
        transition: 0.3s ease-in-out;
        padding-top: 20px;
        z-index: 1000;
      }

      .sidebar.show {
        left: 0;
      }

      .sidebar .close-btn {
        font-size: 30px;
        background: none;
        border: none;
        color: rgb(0, 0, 0);
        position: absolute;
        top: 20px;
        right: 20px;
        cursor: pointer;
      }

      .sidebar ul {
        list-style-type: none;
        padding: 0;
      }

      .sidebar ul li {
        padding: 15px;
        cursor: pointer;
        font-size: 18px;
      }

      .sidebar ul li:hover {
        background-color: #bdc0c3;
      }

      .back-home-btn {
        background-color: #000000;
        color: white;
        border: none;
        padding: 10px;
        width: 100%;
        cursor: pointer;
        position: absolute;
        bottom: 20px;
      }

      .back-home-btn:hover {
        background-color: #3b3c3d;
      }

      /* Main Content */
      .main-content {
        padding: 20px;
        background-color: #ffffff;
        text-align: center;
      }

      .profile-section,
      .order-details {
        display: none;
      }

      .profile-section.show,
      .order-details.show {
        display: block;
      }

      .profile-section h2 {
        font-size: 28px;
        margin-top: 10px;
      }

      .profile-section p {
        font-size: 18px;
      }

      /* Dynamic Avatar */
      .user-avatar {
        font-size: 60px;
        color: #d25555;
        font-weight: bold;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #e0e0e0;
        margin: 15px auto;
      }

      .order-details h3 {
        font-size: 24px;
        margin-bottom: 15px;
      }

      .order-details p {
        font-size: 18px;
        margin-bottom: 10px;
      }

      /* Logout Button */
      .logout-btn {
        background-color: #e47467;
        color: white;
        border: none;
        padding: 10px 20px;
        font-size: 18px;
        cursor: pointer;
        width: 100%;
        max-width: 200px;
        margin-top: 20px;
        text-align: center;
      }

      .logout-btn:hover {
        background-color: #c0392b;
      }
      .logout-icon {
        color: black;
        font-size: 24px;
      }
      .cancelorder-section {
        display: none;
      }

      .cancelorder-section.show {
        display: block;
      }
      .cancelorder-section {
        display: none; /* Hide initially */
        max-width: 400px;
        margin: 50px auto;
        padding: 20px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border: 1px solid #ddd;
        text-align: center;
      }

      .cancelorder-section h2 {
        font-size: 22px;
        margin-bottom: 15px;
        color: #333;
      }

      .cancelorder-section label {
        display: block;
        font-size: 14px;
        margin-bottom: 5px;
        text-align: left;
        font-weight: 600;
        color: #555;
      }

      .cancelorder-section input {
        width: 100%;
        padding: 10px;
        margin-bottom: 15px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 16px;
        transition: all 0.3s ease;
      }

      .cancelorder-section input:focus {
        border-color: #007bff;
        outline: none;
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.3);
      }

      .cancelorder-section button {
        width: 100%;
        padding: 12px;
        font-size: 16px;
        background: #e63946;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .cancelorder-section button:hover {
        background: #c92c3a;
      }
    </style>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Header -->
    <header>
      <button class="menu-btn" onclick="toggleSidebar()">☰</button>
      <img src="/images/logo.png" alt="Logo" />
    </header>

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
      <button class="close-btn" onclick="toggleSidebar()">✖</button>
      <ul>
        <li onclick="showProfile()">👤 Profile</li>
        <li onclick="showOrderDetails()">📦 Order History</li>
        <li onclick="trackOrderDetails()">📦 Track Order</li>
        <li onclick="requestCancelDetails()">📦 Cancel Order</li>
        <li>
          <form method="POST" action="/logout">
            <button type="submit" class="btn btn-link">
              <i class="bi bi-box-arrow-right"></i>
            </button>
          </form>
        </li>
      </ul>
      <button class="back-home-btn" onclick="window.location.href = '/'">
        Back to Home
      </button>
    </div>

    <!-- Main content area -->
    <div class="main-content">
      <!-- Profile Section (Default) -->
      <div class="profile-section show" id="profileSection">
        <div class="user-avatar">
          <span><%= user.name.charAt(0) %></span>
        </div>
        <h2><%= user.name %></h2>
        <p>📧 <%= user.email %></p>
        <p>📞 <%= user.mobile %></p>
      </div>

      <!-- Order Details Section -->
      <div class="order-details" id="orderDetailsSection">
        <h3>Order History</h3>

        <% if (orders.length > 0) { %>
        <table>
          <thead>
            <tr style="background-color: #f2f2f2">
              <th>Order ID</th>
              <th>Product Name</th>
              <th>Payment Status</th>
              <th>Order Date</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { %>
            <tr>
              <td data-label="Order ID"><%= order.id %></td>

              <td data-label="Product Name">
                <% order.items.items.forEach(item => { %>
                <p><%= item.product_name %> (Qty: <%= item.quantity %>)</p>
                <% }) %>
              </td>

              <td data-label="Payment Status"><%= order.payment_status %></td>
              <td data-label="Order Date">
                <%= order.order_date.toLocaleDateString() %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } else { %>
        <p>No orders found.</p>
        <% } %>
      </div>

      <!-- Track Order Section -->
      <div class="order-details" id="trackOrderSection">
        <h3>Track Your Order</h3>
        <marquee
          >Track your delivery status, which will be updated shortly</marquee
        >

        <% if (orders.length > 0) { %>
        <table>
          <thead>
            <tr style="background-color: #f2f2f2">
              <th>Order ID</th>
              <th>Product Name</th>
              <th>Order Date</th>
              <th>Estimated Delivery</th>
              <th>Delivery Status</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { %>
            <tr>
              <td data-label="Order ID"><%= order.id %></td>
              <td data-label="Product Name">
                <% order.items.items.forEach(item => { %>
                <p><%= item.product_name %> (Qty: <%= item.quantity %>)</p>
                <% }) %>
              </td>
              <td data-label="Order Date">
                <%= order.order_date.toLocaleDateString() %>
              </td>
              <td data-label="Estimated Delivery">
                <%= order.estimated_delivery.toLocaleDateString() %>
              </td>
              <td data-label="Current Status"><%= order.delivery_status %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (typeof message !== "undefined") { %>
        <div class="alert <%= success ? 'alert-success' : 'alert-danger' %>">
          <%= message %>
        </div>
        <% } %> <% } else { %>
        <p>No active orders to track.</p>
        <% } %>
      </div>

      <div class="cancelorder-section" id="cancelorderSection">
        <h3>Request cancel order</h3>
        <form id="cancelOrderForm" method="POST" action="/cancelorder">
          <label for="orderId">Order ID:</label>
          <input type="text" id="orderId" name="id" required />

          <label for="userEmail">Email:</label>
          <input type="email" id="userEmail" name="email" required />

          <button type="submit">Request Cancellation</button>
        </form>
      </div>
    </div>

    <script>
      // JavaScript for toggling and content switching
      function toggleSidebar() {
        document.getElementById("sidebar").classList.toggle("show");
      }

      function showProfile() {
        document.getElementById("profileSection").classList.add("show");
        document.getElementById("orderDetailsSection").classList.remove("show");
        document.getElementById("trackOrderSection").classList.remove("show");
        document.getElementById("cancelorderSection").classList.remove("show");
      }

      function showOrderDetails() {
        document.getElementById("orderDetailsSection").classList.add("show");
        document.getElementById("profileSection").classList.remove("show");
        document.getElementById("trackOrderSection").classList.remove("show");
        document.getElementById("cancelorderSection").classList.remove("show");
      }
      function trackOrderDetails() {
        document.getElementById("trackOrderSection").classList.add("show");
        document.getElementById("profileSection").classList.remove("show");
        document.getElementById("orderDetailsSection").classList.remove("show");
        document.getElementById("cancelorderSection").classList.remove("show");
      }

      function requestCancelDetails() {
        document.getElementById("cancelorderSection").classList.add("show");
        document.getElementById("trackOrderSection").classList.remove("show");
        document.getElementById("profileSection").classList.remove("show");
        document.getElementById("orderDetailsSection").classList.remove("show");
      }
    </script>
  </body>
</html>
