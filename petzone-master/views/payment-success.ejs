<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Confirmed</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.10.2/lottie.min.js"></script>
    <style>
      /* Global styles for the body and page */
      body {
        font-family: Arial, sans-serif;
      }

      /* Modal styles */
      #confirmation-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7); /* Semi-transparent background */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        display: none; /* Hidden by default */
      }

      #modal-content {
        background: #fff;
        padding: 30px;
        text-align: center;
        border-radius: 10px;
        width: 80%;
        max-width: 400px;
        position: relative;
      }

      #order-confirmed {
        width: 150px;
        height: 150px;
        margin: 20px auto;
      }

      h1 {
        font-size: 24px;
        margin-bottom: 20px;
      }
      #go-home-btn {
        background-color: #000000;
        color: white;
        padding: 10px 20px;
        font-size: 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        margin-top: 20px;
      }

      #go-home-btn:hover {
        background-color: #343534;
      }
    </style>
  </head>
  <body>
    <!-- Confirmation Modal -->
    <div id="confirmation-modal">
      <div id="modal-content">
        <h1>Payment Successful! </br> Order confirmed</h1>
        <div id="order-confirmed"></div>
        <h1>Track the order in your profile</h1>
        <button id="go-home-btn" onclick="window.location.href = '/'">
          Go Back to Home
        </button>
      </div>
    </div>

    <script>
      // Load Lottie animation (checkmark animation)
      lottie.loadAnimation({
        container: document.getElementById("order-confirmed"),
        renderer: "svg",
        loop: false,
        autoplay: true,
        path: "json/Animation check.json", // Path to your Lottie JSON animation
      });

      // Show the confirmation modal
      document.getElementById("confirmation-modal").style.display = "flex";

      // After the animation finishes (4 seconds), allow the user to go back to home page
      setTimeout(() => {
        document.getElementById("go-home-btn").style.display = "block"; // Show the "Go Home" button after animation
      }, 4000); // Adjust this based on your animation's duration

      // Optional: Automatically close the modal after a set time or keep it until the user clicks the button
      // setTimeout(() => {
      //   window.location.href = "/"; // Redirect to home page after animation
      // }, 5000); // Wait for 5 seconds before redirecting
    </script>
  </body>
</html>
